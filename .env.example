# Application
APP_NAME=desafio-backend-python-ai
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (used by docker-compose's "db" service and by the API)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=desafio
# Host port where Postgres is exposed (change it if 5433 is already in use)
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/desafio
# Running the API outside Docker? Use the exposed port instead:
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/desafio
# Separate database used ONLY by the test suite. Outside Docker:
# TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/desafio_test

# Redis (cache only; Postgres stays the source of truth). If Redis is down the
# API keeps working straight from Postgres. Leave REDIS_URL empty to disable it.
# Host port where Redis is exposed (change it if 6379 is already in use)
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379/0
# Running the API outside Docker? REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=0.2
TASK_LIST_CACHE_TTL_SECONDS=60
TASK_ASSIST_CACHE_TTL_SECONDS=3600

# JWT
# HS256 needs at least 32 bytes; a shorter key makes PyJWT warn.
# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production-with-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS (frontend origins, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000

# AI Agent - choose ONE option
# "test" = fake model, no API key, the agent calls tools with dummy data
LLM_MODEL=test
# Enforced automatically with APP_ENV=production; opt in locally if desired.
AI_LIMITS_ENABLED=false
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=50
AI_MAX_OUTPUT_TOKENS=800
# Embeddings for the task search index; empty/"none" = lexical search only
EMBEDDING_MODEL=
# Hides PydanticAI's startup banner in the logs
PYDANTIC_AI_NO_BANNER=1

# Ollama (free, local):
# LLM_MODEL=ollama:llama3.2
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Gemini (has a free tier):
# LLM_MODEL=google:gemini-3.8-flash
# GOOGLE_API_KEY=your-gemini-api-key

# OpenAI:
# LLM_MODEL=openai:<model-name>
# OPENAI_API_KEY=your-openai-api-key
